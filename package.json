{
  "name": "val-archives",
  "version": "1.0.0",
  "description": "A local-first magical archive for preserving fictional lives and AI-driven RPG worlds.",
  "author": "wuju97",
  "main": "electron.js",
  "homepage": "https://val-archives.vercel.app",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:build": "next build && electron-builder"
  },
  "build": {
    "appId": "com.valarchives.app",
    "productName": "Val Archives",
    "copyright": "Copyright 2026 wuju97",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "package.json",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "next.config.ts",
      "!node_modules/.cache/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/concurrently/**/*",
      "!node_modules/wait-on/**/*",
      "!**/*.map",
      "!dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "16.2.9"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  }
}