 <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="256" height="256">
  <rect width="256" height="256" rx="48" fill="#080808"/>
  <rect width="256" height="256" rx="48" fill="url(#bg)"/>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="256" y2="256" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0f0f1a"/>
      <stop offset="100%" stop-color="#080808"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="256" y2="256" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#3b82f6"/>
    </linearGradient>
  </defs>
  <!-- V shape -->
  <path d="M 60 72 L 128 184 L 196 72" fill="none" stroke="url(#accent)" stroke-width="22" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Glow dot at bottom of V -->
  <circle cx="128" cy="184" r="10" fill="#7c3aed" opacity="0.8"/>
  <!-- Stars -->
  <circle cx="80" cy="110" r="2.5" fill="#3b82f6" opacity="0.6"/>
  <circle cx="176" cy="100" r="2" fill="#7c3aed" opacity="0.5"/>
  <circle cx="128" cy="58" r="3" fill="#3b82f6" opacity="0.4"/>
</svg>